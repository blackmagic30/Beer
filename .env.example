NODE_ENV=development
# Public discovery target for this build: guinness, carlton_draft,
# stone_and_wood, or happy_hour. Production release evidence binds this value.
TARGET_BEER=guinness
# Emergency-safe, read-only Railway staging mode for a verified backup restore.
# Leave false outside the documented restore rehearsal procedure.
RESTORE_REHEARSAL_MODE=false
RESTORE_REHEARSAL_PHASE=
RESTORE_REHEARSAL_BACKUP_ID=
RESTORE_REHEARSAL_SOURCE_MANIFEST_SHA256=
RESTORE_REHEARSAL_RUNTIME_ATTESTATION_SHA256=
RESTORE_REHEARSAL_EXPECTED_RAILWAY_PROJECT_ID=
RESTORE_REHEARSAL_EXPECTED_RAILWAY_ENVIRONMENT_ID=
RESTORE_REHEARSAL_EXPECTED_RAILWAY_SERVICE_ID=
RESTORE_REHEARSAL_EXPECTED_SUPABASE_URL=
RESTORE_REHEARSAL_EXPECTED_REDIS_SERVICE_ID=
RESTORE_REHEARSAL_PRODUCTION_SUPABASE_URL=
RESTORE_REHEARSAL_BACKUP_SUPABASE_URL=
RESTORE_REHEARSAL_REDIS_ENVIRONMENT_ID=
RESTORE_REHEARSAL_REDIS_SERVICE_ID=
RESTORE_REHEARSAL_REDIS_SENTINEL=
RESTORE_REHEARSAL_ACCESS_USERNAME=
RESTORE_REHEARSAL_ACCESS_PASSWORD=
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
# For hosted staging, use the exact non-production Railway HTTPS origin.
# Never reuse the production pintpath.au origin.
# PUBLIC_BASE_URL=https://your-staging-service.up.railway.app
# Production requires an HTTPS PUBLIC_BASE_URL, GOOGLE_MAPS_API_KEY, GOOGLE_MAPS_MAP_ID,
# and a least-privilege pooled Postgres URL with explicit TLS.
# ADMIN_EMAILS can stay blank while the official owner/admin email is pending;
# admin routes fail closed until it is configured.
DATABASE_PATH=./data/pint-path.sqlite
# Local synthetic tests use DATABASE_PATH. Full-scale staging/production must
# remove DATABASE_PATH and set the reviewed pooled Postgres connection instead.
# Use a direct/session endpoint on explicit port 5432, never a transaction
# pooler. The credential must be a separate LOGIN whose only membership is the
# NOLOGIN pintpath_runtime role; the application selects that effective role in
# every PostgreSQL startup packet before pooled queries can run.
DATABASE_URL=
# Required beside DATABASE_URL in hosted staging and production. It must point
# to the same pinned database with a distinct login that is a member only of
# pintpath_maintenance (never pintpath_runtime or pintpath_migrator). The web
# query pool never receives this URL; it is used only by the bounded privacy
# retention and account-anonymisation repositories. Use the same explicit 5432
# direct/session boundary; its pool selects pintpath_maintenance at startup.
DATABASE_MAINTENANCE_URL=
# Required for hosted staging/production beside both URLs. Railway injects the
# exact stock Postgres self-signed CA PEM as a sealed multiline variable; app
# startup validates the one CA against the independently reviewed DER SHA-256,
# materializes only owned mode-700/mode-600 temporary files, pins one private
# fd12 address, authenticates the stock leaf as localhost, and removes the
# temporary authority at shutdown. Never configure a host filesystem path.
PINTPATH_POSTGRES_ROOT_CA_PEM=
PINTPATH_POSTGRES_ROOT_CA_DER_SHA256=
# Default complete is mandatory for production, restore, normal staging, and
# account-deletion rehearsal. staging-bootstrap is operator-only: it validates
# the first permanent-staging Postgres/Redis identities, performs no provider
# canary, and the web server refuses to start in that phase.
PINTPATH_IDENTITY_REGISTRY_PHASE=complete
PINTPATH_PERMANENT_STAGING_RAILWAY_PROJECT_ID=
PINTPATH_PERMANENT_STAGING_RAILWAY_ENVIRONMENT_ID=
PINTPATH_PERMANENT_STAGING_RAILWAY_SERVICE_ID=
# Bind the actual non-secret provider resource ID from a provider service
# instance, not Railway's shared top-level service ID. Railway identities use
# railway:<environment-id>:<service-id>. Expected is the private-register pin;
# complete mode requires the two real sibling environment identities.
PINTPATH_DATABASE_RESOURCE_ID=
PINTPATH_EXPECTED_DATABASE_RESOURCE_ID=
PINTPATH_FORBIDDEN_DATABASE_RESOURCE_IDS=
PINTPATH_PERMANENT_STAGING_DATABASE_RESOURCE_ID=
# In permanent integrated staging and production, hash the exact credentialed
# URL locally and store only the digest. Expected must match the live URL;
# forbidden must include the other registered environments' digests.
PINTPATH_EXPECTED_DATABASE_URL_SHA256=
PINTPATH_FORBIDDEN_DATABASE_URL_SHA256S=
PINTPATH_PERMANENT_STAGING_DATABASE_URL_SHA256=
# Keep this at one on Railway for forwarded scheme/host handling. Client
# security identity uses Railway's platform-provided X-Real-IP, not proxy hop count.
TRUST_PROXY_HOPS=1
# Canonical production requires this exact reviewed custom origin. Permanent
# staging uses its separately reviewed staging project origin instead.
SUPABASE_URL=https://auth.pintpath.au
# Canonical production and every hosted staging/rehearsal runtime require the
# exact project `sb_publishable_...` key here and its exact `sb_secret_...` key
# in SUPABASE_SERVICE_ROLE_KEY. Legacy JWT keys remain accepted only for local
# development compatibility. Never place a secret key in SUPABASE_ANON_KEY: it
# is exposed to the public viewer configuration.
SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=replace_with_exact_project_server_key
# Configure Google OAuth in the Supabase dashboard for this launch.
# Add redirect URLs for http://localhost:3000/auth/callback and https://pintpath.au/auth/callback.
# Apple stays disabled until authorization-token revocation is implemented and verified.
SUPABASE_OAUTH_PROVIDERS=google
SUPABASE_MENU_CAPTURE_TABLE=venue_menu_captures
ADMIN_EMAILS=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAP_ID=your_google_vector_map_id
GOOGLE_PLACES_API_KEY=your_server_side_google_places_api_key
OPENAI_API_KEY=your_openai_api_key_for_menu_ocr
OPENAI_MENU_OCR_MODEL=gpt-5.6-sol
OPENAI_MENU_OCR_FALLBACK_MODEL=gpt-4.1
OPENAI_MENU_OCR_REVIEW_PASS=true
# Keep false unless the exact mini snapshot has passed the labelled benchmark
# and the permanent-staging price/project receipt has been independently bound.
OPENAI_MENU_OCR_COST_BOUND_MODE=false
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_DAYS=1
REQUIRE_ADMIN_MFA_IN_PRODUCTION=true
ADMIN_MFA_MAX_AGE_MINUTES=720
REQUIRE_VERIFIED_ACCOUNT_IN_PRODUCTION=true
CONTRIBUTOR_UNLOCK_POINTS=15
CONTRIBUTOR_UNLOCK_DAYS=30
ANALYTICS_MIN_BUCKET_SIZE=5
REPORT_TIMEZONE=Australia/Melbourne
# disabled = no delivery; mock = local/test only; resend = real provider delivery.
REPORT_EMAIL_MODE=disabled
# Real delivery is opt-in. Verify a sending domain with Resend before enabling these values.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Required and monitored whenever REPORT_EMAIL_MODE=resend.
REPORT_EMAIL_REPLY_TO=
# The production web process checks after this Melbourne-local day/hour and catches up after downtime.
REPORT_DELIVERY_SCHEDULE_ENABLED=false
REPORT_DELIVERY_DAY=2
REPORT_DELIVERY_HOUR=9
REPORT_DELIVERY_CHECK_INTERVAL_MINUTES=60
# Completion notices are separate from optional monthly reports. Canonical production must use resend.
ACCOUNT_DELETION_NOTICE_MODE=disabled
# Use a sending-only Resend key and a verified transactional sender domain.
RESEND_TRANSACTIONAL_API_KEY=
ACCOUNT_DELETION_NOTICE_FROM="Pint Path <account@pintpath.au>"
ACCOUNT_DELETION_NOTICE_REPLY_TO=admin@pintpath.au
# Create the signed Resend webhook for /api/business/account-deletion-notifications/resend-webhook.
# Subscribe to email.delivered, email.delivery_delayed, email.bounced,
# email.failed, email.suppressed, and email.complained.
RESEND_WEBHOOK_SIGNING_SECRET=
# Generate a key with `openssl rand -base64 32`; retain old keyed entries until no outbox row references them.
ACCOUNT_DELETION_NOTICE_ACTIVE_KEY_ID=2026-08
ACCOUNT_DELETION_NOTICE_KEYRING_JSON='{"2026-08":"replace_with_base64_encoded_32_byte_key"}'
ACCOUNT_DELETION_NOTICE_CHECK_INTERVAL_MINUTES=5
# Set true only for the sacrificial drill in permanent integrated staging.
# Leave false in production/development/restore staging. The staging profile
# requires reviewed Railway/Supabase pins, shared TLS Postgres, shared Redis,
# and at least two replicas.
ACCOUNT_DELETION_REHEARSAL_ENABLED=false
ACCOUNT_DELETION_REHEARSAL_EXPECTED_RAILWAY_PROJECT_ID=
ACCOUNT_DELETION_REHEARSAL_EXPECTED_RAILWAY_ENVIRONMENT_ID=
ACCOUNT_DELETION_REHEARSAL_EXPECTED_RAILWAY_SERVICE_ID=
ACCOUNT_DELETION_REHEARSAL_EXPECTED_SUPABASE_URL=
ACCOUNT_DELETION_REHEARSAL_PRODUCTION_SUPABASE_URL=
ACCOUNT_DELETION_REHEARSAL_REPLICA_COUNT=
REDIS_URL=
PINTPATH_REDIS_RESOURCE_ID=
PINTPATH_EXPECTED_REDIS_RESOURCE_ID=
PINTPATH_FORBIDDEN_REDIS_RESOURCE_IDS=
PINTPATH_EXPECTED_REDIS_URL_SHA256=
PINTPATH_FORBIDDEN_REDIS_URL_SHA256S=
PINTPATH_PERMANENT_STAGING_REDIS_RESOURCE_ID=
PINTPATH_PERMANENT_STAGING_REDIS_URL_SHA256=
REDIS_KEY_NAMESPACE=
# Set true with REDIS_URL in full-scale production and permanent integrated staging.
# Local single-process development may remain false.
REQUIRE_REDIS_RATE_LIMITING=false
# Full-scale production must keep this false; no in-memory production override
# is authorised for this launch.
ALLOW_IN_MEMORY_RATE_LIMITING_IN_PRODUCTION=false
DEMO_BILLING_MODE=false
ALLOW_DEMO_BILLING_IN_PRODUCTION=false
ALLOW_DEMO_IMAGE_STORAGE_IN_PRODUCTION=false
# Private server/volume directory for production source evidence files.
# On Railway, keep this under the mounted /app/data volume.
SOURCE_EVIDENCE_STORAGE_DIR=./data/source-evidence
# Private 32+ char HMAC secret for short-lived source-evidence review/download URLs.
# Generate with: openssl rand -base64 32
SOURCE_EVIDENCE_SIGNING_SECRET=replace_with_32_plus_random_characters
SOURCE_EVIDENCE_SIGNED_URL_TTL_SECONDS=300
SOURCE_EVIDENCE_RETENTION_DAYS=90
# Canonical-production-only operational restore copy on a different origin.
# This mutable same-provider copy is not the separately administered WORM
# recovery authority. Permanent staging must leave the next three variables
# absent; it must never inherit the production destination, key, or bucket.
OFFSITE_BACKUP_SUPABASE_URL=https://hfbmhdxrwtihukmixxta.supabase.co
OFFSITE_BACKUP_SERVICE_ROLE_KEY=replace_with_exact_operational_copy_server_key
OFFSITE_BACKUP_BUCKET=pintpath-backups
OFFSITE_BACKUP_INTERVAL_HOURS=24
OFFSITE_BACKUP_RETENTION_DAYS=30
# POS/counter tooling and field-test mode are outside the frozen Free launch.
POS_WEBHOOK_SIGNING_SECRET=
FIELD_TEST_MODE=false
# Keep alcohol-linked rewards disabled until Victorian liquor-promotion legal
# review and each participating venue's licensee approval are recorded.
PINT_POINTS_REWARDS_ENABLED=false
# Keep fixed-round alcohol game mechanics disabled until Apple review and
# Victorian responsible-promotion legal approval are both recorded.
ALCOHOL_GAMIFICATION_ENABLED=false
# Required in production before either alcohol-linked feature flag can be true.
# Record the internal legal/Apple approval ticket or signed counsel reference.
ALCOHOL_PROMOTION_APPROVAL_REFERENCE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Frozen Free launch: keep both values explicitly false. All public billing,
# trial, upgrade, reconciliation, portal, and Stripe-webhook entry points are
# denied and their credentials remain absent. A future commercial release needs
# a new reviewed candidate and contract.
COMMERCIAL_LAUNCH_ENABLED=false
CONSUMER_PAID_ENROLLMENT_ENABLED=false
# Pricing is deferred for this release. Keep the trial disabled while
# COMMERCIAL_LAUNCH_ENABLED=false. Allowed future values are 0, 30, or 60;
# the commercial contract must be reviewed again before choosing a nonzero value.
VENUE_PRO_TRIAL_DAYS=0
VENUE_PRO_TRIAL_REQUIRE_PAYMENT_METHOD=false
PINTPATH_REPORT_DELIVER=false
# Release-data gate only. Empty means every nonblank public-directory suburb
# is marketed. For a pilot, use a comma-separated, case-insensitive suburb list.
PINTPATH_DATA_MARKETED_SUBURBS=
