NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
# For hosted staging later, use:
# PUBLIC_BASE_URL=https://pintpath.beer
# Production requires an HTTPS PUBLIC_BASE_URL and GOOGLE_MAPS_API_KEY.
# ADMIN_EMAILS can stay blank while the official owner/admin email is pending;
# admin routes fail closed until it is configured.
DATABASE_PATH=./data/pint-path.sqlite
TRUST_PROXY=true
PARSE_CONFIDENCE_THRESHOLD=0.72
BATCH_CALL_CIRCUIT_BREAKER_THRESHOLD=5
BATCH_CALL_LOW_SIGNAL_THRESHOLD=12
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_browser_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Configure Google, Apple, and Facebook OAuth providers in the Supabase dashboard.
# Add redirect URLs for http://localhost:3000/account.html and your PUBLIC_BASE_URL account page.
SUPABASE_OAUTH_PROVIDERS=google,apple,facebook
SUPABASE_RESULTS_TABLE=call_results
ADMIN_EMAILS=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAP_ID=optional_google_maps_map_id
GOOGLE_PLACES_API_KEY=your_server_side_google_places_api_key
OPENAI_API_KEY=your_openai_api_key_for_menu_ocr
SESSION_TTL_DAYS=60
ADMIN_SESSION_TTL_DAYS=7
REQUIRE_ADMIN_MFA_IN_PRODUCTION=true
ADMIN_MFA_MAX_AGE_MINUTES=720
REQUIRE_VERIFIED_ACCOUNT_IN_PRODUCTION=true
FREE_PRICE_REVEALS_PER_DAY=5
CONTRIBUTOR_UNLOCK_POINTS=15
CONTRIBUTOR_UNLOCK_DAYS=30
ANALYTICS_MIN_BUCKET_SIZE=5
REDIS_URL=
# Controlled beta can fall back to in-memory rate limits if Redis is not configured.
# Full-scale production should set REDIS_URL and set this to false.
ALLOW_IN_MEMORY_RATE_LIMITING_IN_PRODUCTION=true
DEMO_BILLING_MODE=true
ALLOW_DEMO_BILLING_IN_PRODUCTION=false
ALLOW_DEMO_IMAGE_STORAGE_IN_PRODUCTION=false
SOURCE_EVIDENCE_SIGNING_SECRET=replace_with_32_plus_random_characters
SOURCE_EVIDENCE_SIGNED_URL_TTL_SECONDS=300
FIELD_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_monthly_199_aud
STRIPE_PRICE_YEARLY=price_yearly_19_aud
STRIPE_PLUS_PRICE_ID=price_bar_plus_aud
STRIPE_PRO_PRICE_ID=price_bar_pro_aud
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Legacy Twilio/ElevenLabs calling bot is disabled for Pint Path.
# Keep these commented placeholders only if we deliberately bring it back later.
ENABLE_LEGACY_CALL_AUTOMATION=false
# TARGET_BEER=guinness
# OUTBOUND_CALLS_ENABLED=false
# OUTBOUND_CALL_TIMEZONE=Australia/Melbourne
# OUTBOUND_CALL_WINDOW_START=11:00
# OUTBOUND_CALL_WINDOW_END=20:30
# OUTBOUND_CALL_ALLOWED_DAYS=mon,tue,wed,thu,fri,sat,sun
# OUTBOUND_REPEAT_GUARD_SECONDS=300
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+61300000000
# TWILIO_CALL_TIME_LIMIT_SECONDS=30
# TWILIO_VALIDATE_SIGNATURES=true
# ALLOW_UNSIGNED_TWILIO_WEBHOOKS_IN_PRODUCTION=false
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_AGENT_ID=agent_XXXXXXXXXXXXXXXX
# ELEVENLABS_WEBHOOK_SECRET=optional_shared_secret_from_elevenlabs
# ALLOW_UNSIGNED_ELEVENLABS_WEBHOOKS_IN_PRODUCTION=false
