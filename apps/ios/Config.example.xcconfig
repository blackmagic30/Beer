// Copy this file to Config.xcconfig locally if you want to override defaults.
// Do not commit real secrets. The mobile app must never contain service-role keys.
// The project has a safe hosted default; this file is only for local developer overrides.

PRODUCT_BUNDLE_IDENTIFIER = au.pintpath.beermap
DEVELOPMENT_TEAM =

// Use the existing hosted or local BeerMap/Pint Path backend.
// Hosted default: https:/$()/pintpath.au
// iOS simulator with local backend: http:/$()/127.0.0.1:3000
// Physical device with local backend: use an HTTPS tunnel or a LAN URL reachable from the device.
PINT_PATH_API_BASE_URL = https:/$()/pintpath.au

// Optional public Supabase Auth config used by native email/password and Google/Apple OAuth.
// Email/password login works through the existing Express API without these.
// Never use a Supabase service-role key here.
SUPABASE_URL =
SUPABASE_ANON_KEY =
