{
  "name": "pint-path",
  "version": "0.1.0",
  "private": true,
  "description": "Pint Path Melbourne beer price and happy-hour map.",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/ensure-native-dependencies.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc --project tsconfig.json && mkdir -p dist/src/db && cp src/db/schema.sql src/db/postgres-schema.sql dist/src/db/",
    "start": "node dist/src/server.js",
    "predeploy:production": "NODE_ENV=production node dist/src/config/env.js",
    "deployment:guard:check": "node scripts/check-production-deploy-guard.mjs",
    "venues:import": "tsx scripts/import-melbourne-venues.ts",
    "venues:import:city": "tsx scripts/import-melbourne-venues.ts --city-backfill --city-only",
    "venues:import:inner-ring": "tsx scripts/import-melbourne-venues.ts --inner-ring-backfill --inner-ring-only",
    "menus:discover": "tsx scripts/discover-menu-sources.ts",
    "menus:queue-review": "tsx scripts/queue-menu-crawler-results.ts",
    "ocr:benchmark": "tsx scripts/benchmark-menu-ocr.ts",
    "ocr:benchmark:live": "tsx scripts/benchmark-menu-ocr.ts --live",
    "menus:publish-map-base": "tsx scripts/publish-source-ingestion-map-base.ts",
    "menus:promote-reviewed": "tsx scripts/promote-reviewed-price-data.ts",
    "readiness:data": "tsx scripts/production-data-readiness.ts",
    "readiness:providers": "tsx scripts/provider-readiness-check.ts",
    "supabase:keys:consumer-compatibility:check": "vitest run test/supabase-key-consumer-compatibility.test.ts test/browser-supabase-new-key.test.ts test/supabase-client.test.ts test/account-page.test.ts test/env-config.test.ts test/ios-launch-safety.test.ts test/native-mobile-remediation.test.ts test/production-smoke-check.test.ts test/provider-readiness-reporting.test.ts test/staging-supabase-key-canary.test.ts test/permanent-staging-supabase-key-input.test.ts test/permanent-staging-supabase-key-replacement.test.ts test/permanent-staging-supabase-key-canary-b.test.ts test/permanent-staging-supabase-legacy-key-disable.test.ts test/permanent-staging-supabase-old-key-denial.test.ts test/railway-sealed-variable-readiness.test.ts test/app-deployment-metadata.test.ts test/postgres-logical-offsite.test.ts test/postgres-logical-offsite-cli.test.ts test/postgres-logical-offsite-retrieval.test.ts test/postgres-account-deletion-recovery-fixture.test.ts test/postgres-private-storage-recovery.test.ts test/postgres-migration-cli.test.ts test/source-ingestion-map-base.test.ts test/reviewed-price-promotion.test.ts test/business-demo.test.ts test/release-workflows.test.ts test/security-scan.test.ts test/redact.test.ts test/offsite-backup.test.ts test/offsite-backup-download.test.ts test/rehearse-data-restore.test.ts test/stage-restored-source-evidence.test.ts test/restore-operator-browser-containment.test.ts test/venue-import-data-quality.test.ts --maxWorkers=1",
    "db:postgres:reviewed-price:kernel:contract:check": "vitest run test/postgres-reviewed-price-promotion-kernel.test.ts --maxWorkers=1",
    "db:postgres:logical-state:v2:contract:check": "vitest run test/postgres-logical-state.test.ts --maxWorkers=1",
    "db:postgres:backup:v4:offline-contract:check": "vitest run test/postgres-logical-backup-v4.test.ts test/postgres-logical-backup-v4-source-authority.test.ts test/postgres-logical-backup-v4-source-authority-v2.test.ts test/postgres-logical-backup-v4-toc.test.ts test/postgres-logical-physical-schema-v4.test.ts test/postgres-logical-scratch-restore-v4.test.ts test/postgres-tool-runtime-closure-v4.test.ts test/postgres-tool-authority.test.ts test/postgres-logical-restore.test.ts --maxWorkers=1",
    "readiness:railway:sealed": "tsx scripts/railway-sealed-variable-readiness.ts --policy ops/railway/permanent-staging-sealed-variable-policy.json",
    "readiness:railway:mutation-boundary": "tsx scripts/check-railway-mutation-boundary.ts --policy ops/railway/production-staging-mutation-policy.json",
    "railway:staging:provider-variable:write": "tsx scripts/execute-permanent-staging-provider-variable-write.ts",
    "reports:generate": "tsx scripts/generate-monthly-reports.ts",
    "reports:deliver": "tsx scripts/deliver-monthly-reports.ts",
    "reports:deliver:mock": "REPORT_EMAIL_MODE=mock tsx scripts/deliver-monthly-reports.ts",
    "data:backup": "tsx scripts/backup-data.ts",
    "data:backup:verify": "tsx scripts/verify-data-backup.ts",
    "data:backup:rehearse": "tsx scripts/rehearse-data-restore.ts",
    "data:backup:attest-restore": "tsx scripts/create-restore-runtime-attestation.ts",
    "data:backup:activate-restore": "tsx scripts/activate-restore-runtime.ts",
    "data:backup:verify-runtime": "tsx scripts/verify-restore-runtime.ts",
    "data:backup:offsite": "tsx scripts/backup-data-offsite.ts",
    "data:backup:download-offsite": "tsx scripts/download-offsite-backup.ts",
    "data:backup:stage-evidence": "tsx scripts/stage-restored-source-evidence.ts",
    "db:postgres:schema:generate": "tsx scripts/generate-postgres-schema.ts",
    "db:postgres:schema:check": "tsx scripts/generate-postgres-schema.ts --check",
    "db:postgres:migration": "tsx scripts/postgres-migration.ts",
    "db:postgres:migration:contract:generate": "tsx scripts/generate-postgres-migration-contract.ts --write",
    "db:postgres:migration:contract:check": "tsx scripts/generate-postgres-migration-contract.ts --check",
    "db:postgres:runtime:verify": "tsx scripts/verify-postgres-runtime.ts",
    "db:postgres:backup:logical": "tsx scripts/backup-postgres-logical.ts",
    "db:postgres:backup:login": "tsx scripts/manage-postgres-logical-backup-login.ts",
    "db:postgres:backup:logical:offsite": "tsx scripts/attest-postgres-logical-backup-offsite.ts",
    "db:postgres:backup:logical:retrieve": "tsx scripts/retrieve-postgres-logical-offsite.ts",
    "db:postgres:backup:logical:worm": "tsx scripts/attest-postgres-logical-worm.ts",
    "db:postgres:restore:logical": "tsx scripts/restore-postgres-logical.ts",
    "db:postgres:backup:private-storage-recovery": "tsx scripts/capture-postgres-private-storage-recovery.ts",
    "db:postgres:restore:private-storage-recovery": "tsx scripts/restore-postgres-private-storage-recovery.ts",
    "db:postgres:deletion:recovery-proof": "tsx scripts/prove-postgres-account-deletion-recovery.ts",
    "db:postgres:deletion:replay": "tsx scripts/replay-postgres-account-deletion-tombstones.ts",
    "test:seed:pintpath": "ALLOW_FAKE_SEED=true tsx scripts/seed-pintpath-fake-data.ts",
    "test:reset:pintpath": "ALLOW_FAKE_SEED=true tsx scripts/reset-pintpath-test-data.ts",
    "test:e2e:pintpath": "vitest run test/pintpath-release-readiness.test.ts",
    "test:reports": "vitest run test/pintpath-release-readiness.test.ts --testNamePattern report",
    "test:permissions": "vitest run test/pintpath-release-readiness.test.ts test/business-demo.test.ts --testNamePattern \"access|admin|assigned|permission|privacy|tier|venue manager\"",
    "test:security:pintpath": "vitest run test/pintpath-release-readiness.test.ts",
    "test:db:postgres:backup:logical:worm:aws": "vitest run test/postgres-logical-worm.integration.test.ts",
    "test:staging:auth:probe:pg17": "vitest run test/staging-private-auth-probe.integration.test.ts",
    "test:release:pintpath": "npm run check && npm run readiness:providers && npm run release:evidence:strict && npm run security:audit",
    "audit:deployment": "npm run build && npm test && npm run readiness:providers && npm run security:scan && npm run security:audit",
    "readiness:launch": "LAUNCH_READINESS_STRICT=true NODE_ENV=production tsx scripts/provider-readiness-check.ts",
    "staging:auth:probe": "node dist/scripts/staging-private-auth-probe.js",
    "staging:load:soak": "tsx scripts/permanent-staging-load-soak.ts",
    "smoke:production": "node scripts/production-smoke-check.mjs",
    "smoke:production:auth": "node scripts/production-smoke-check.mjs --strict-auth",
    "release:evidence": "tsx scripts/validate-release-evidence.ts",
    "release:evidence:strict": "tsx scripts/validate-release-evidence.ts --strict",
    "permanent-staging:cost:contract:check": "vitest run test/permanent-staging-cost-policy.test.ts test/permanent-staging-app-deployment-executor.test.ts",
    "pretest": "node scripts/ensure-native-dependencies.mjs",
    "test": "vitest run test",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --audit-level=low",
    "check": "npm run build && npm run test && npm run security:scan && npm run deployment:guard:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1098.0",
    "@aws-sdk/client-sts": "3.1098.0",
    "@aws-sdk/credential-providers": "3.1098.0",
    "@supabase/supabase-js": "2.112.3",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "openai": "^6.33.0",
    "parse5": "8.0.1",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
