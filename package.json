{
  "name": "pint-path",
  "version": "0.1.0",
  "private": true,
  "description": "Pint Path Melbourne beer price and happy-hour map.",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc --project tsconfig.json && mkdir -p dist/src/db && cp src/db/schema.sql dist/src/db/schema.sql",
    "start": "node dist/src/server.js",
    "venues:import": "tsx scripts/import-melbourne-venues.ts",
    "venues:import:city": "tsx scripts/import-melbourne-venues.ts --city-backfill --city-only",
    "venues:import:inner-ring": "tsx scripts/import-melbourne-venues.ts --inner-ring-backfill --inner-ring-only",
    "menus:discover": "tsx scripts/discover-menu-sources.ts",
    "menus:queue-review": "tsx scripts/queue-menu-crawler-results.ts",
    "readiness:providers": "tsx scripts/provider-readiness-check.ts",
    "reports:generate": "tsx scripts/generate-monthly-reports.ts",
    "reports:deliver:mock": "REPORT_EMAIL_MODE=mock tsx scripts/generate-monthly-reports.ts --deliver",
    "test:seed:pintpath": "ALLOW_FAKE_SEED=true PINTPATH_TEST_DATABASE_PATH=data/pintpath-release-test.sqlite tsx scripts/seed-pintpath-fake-data.ts",
    "test:reset:pintpath": "ALLOW_FAKE_SEED=true PINTPATH_TEST_DATABASE_PATH=data/pintpath-release-test.sqlite tsx scripts/reset-pintpath-test-data.ts",
    "test:e2e:pintpath": "vitest run test/pintpath-release-readiness.test.ts",
    "test:reports": "vitest run test/pintpath-release-readiness.test.ts --testNamePattern report",
    "test:permissions": "vitest run test/pintpath-release-readiness.test.ts test/business-demo.test.ts --testNamePattern \"access|admin|assigned|permission|privacy|tier|venue manager\"",
    "test:security:pintpath": "vitest run test/pintpath-release-readiness.test.ts",
    "test:release:pintpath": "npm run build && npm run test:e2e:pintpath && npm run readiness:providers && npm run security:scan && npm run security:audit",
    "audit:deployment": "npm run build && npm test && npm run readiness:providers && npm run security:scan && npm run security:audit",
    "readiness:launch": "LAUNCH_READINESS_STRICT=true NODE_ENV=production tsx scripts/provider-readiness-check.ts",
    "test": "vitest run test",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run build && npm run test && npm run security:scan"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.33.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
